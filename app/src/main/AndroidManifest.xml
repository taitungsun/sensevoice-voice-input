<?xml version="1.0" encoding="utf-8"?>
<!--
  離線語音辨識服務（系統級）。

  ## 註冊方式參照成熟的開源專案
  參考 `ElishaAz/Sayboard`（Vosk 語音鍵盤，活躍專案）的 AndroidManifest：
  它的 RecognitionService 宣告有四個關鍵點，本檔案全部對齊：
    ① android:exported="true"                     —— 系統要能綁定
    ② <category android:name="android.intent.category.DEFAULT" />  —— isDefault 標記
    ③ android:foregroundServiceType="microphone"  —— 錄音型前景服務
    ④ android:permission="android.permission.RECORD_AUDIO"  —— 限定呼叫方需錄音權限
  Sayboard 另宣告 QUERY_ALL_PACKAGES，以免呼叫方收到 ERROR_INSUFFICIENT_PERMISSIONS。
  本版已移除：targetSdk 28 不受 Android 11 的 App 可見性限制，宣告與否行為相同。
  若日後把 targetSdk 提高到 30 以上，需改用範圍較小的 <queries> 宣告並重新測試。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only used to download the model from HuggingFace; audio never leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 錄音型前景服務（辨識期間顯示狀態，避免被系統回收） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- F21: start the model keeper after boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- F21: buzz when recording starts -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主介面：從桌面圖示開啟（下載模型、檢查狀態）；
             系統「語音輸入 → 辨識服務 → 設定」頁則開啟 SettingsActivity。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ModelsActivity"
            android:exported="false"
            android:label="@string/models_title" />

        <!-- 系統「語音輸入 → 辨識服務 → 設定」入口（recognition_service.xml 引用） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <!-- F21: keeps the model loaded (see KeeperService.kt) -->
        <service
            android:name=".KeeperService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 系統辨識服務。宣告要點見檔案頂部註解（對齊 Sayboard）。 -->
        <service
            android:name=".AsrRecognitionService"
            android:exported="true"
            android:label="@string/service_label"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter android:priority="100">
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

    </application>
</manifest>
